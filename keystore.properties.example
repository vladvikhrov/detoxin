# Скопируйте в keystore.properties (файл в .gitignore) или запустите
# scripts/generate-release-keystore.sh — он создаст ключ и этот файл автоматически.
# Без keystore.properties release-сборка подписывается debug-ключом.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=detoxin_key
keyPassword=CHANGE_ME
